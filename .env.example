# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Used by both the frontend (via import.meta.env) and the /api/tmdb/* functions
# (via process.env) to verify who's calling, so set these in Vercel too.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TMDB API key (themoviedb.org -> Settings -> API -> "API Key (v3 auth)").
# Server-side only -- do NOT prefix with VITE_, or it would be bundled into
# the client JS and exposed to anyone who opens dev tools.
TMDB_API_KEY=
